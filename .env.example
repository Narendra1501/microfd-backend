PORT=5000
# Example Postgres URL (replace with your DB connection string)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASS>@<HOST>:5432/<DB_NAME>?sslmode=require

# JWT settings
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Email (SMTP) credentials for outgoing mail
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password

FACULTY_EMAIL=faculty@example.com

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Notes:
# - Copy this file to .env in development and fill real secrets locally.
# - Do NOT commit real secrets to the repository.
